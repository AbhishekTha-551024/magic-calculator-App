<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calling_gradient">

    <TextView
        android:id="@+id/tvCallingNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="88885"
        android:textColor="@color/white"
        android:textSize="44sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCallingNumber">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_volte"
            android:paddingHorizontal="4dp"
            android:text="VoLTE"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Ringing"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="80dp"
        android:columnCount="3"
        app:layout_constraintBottom_toTopOf="@id/btnHangup">

        <!-- Action Icons Row 1 -->
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_notes" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Notes" />
        </LinearLayout>
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_add_simple" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Add call" />
        </LinearLayout>
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_mute" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Mute" />
        </LinearLayout>
        
        <!-- Action Icons Row 2 -->
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_voicemail" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Record" />
        </LinearLayout>
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_video" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Video call" />
        </LinearLayout>
        <LinearLayout style="@style/CallingActionStyle">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_hold" app:tint="@color/white" />
            <TextView style="@style/CallingTextStyle" android:text="Hold" />
        </LinearLayout>

    </GridLayout>

    <ImageButton
        android:id="@+id/btnHangup"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/circle_red"
        android:src="@drawable/ic_call_end"
        android:padding="20dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />
        
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="50dp"
        android:src="@drawable/ic_dialpad"
        app:layout_constraintBottom_toBottomOf="@id/btnHangup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnHangup"
        app:tint="@color/white" />
        
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="50dp"
        android:src="@drawable/ic_speaker"
        app:layout_constraintBottom_toBottomOf="@id/btnHangup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnHangup"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
