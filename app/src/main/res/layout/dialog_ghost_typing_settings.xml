<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FF18181B"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Bar & Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghost Typing Panel"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#33FFCC00"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="PRO"
                        android:textColor="#FFCC00"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCloseGhostDialog"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFFFFF" />
            </RelativeLayout>

            <!-- Main Toggle Switch -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_notes"
                        app:tint="#FFCC00"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Enable Ghost Typing"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swGhostEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="@color/dialer_green" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Target Ghost Number Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghost Number / Sequence to Type"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The exact digits that will be typed on screen automatically."
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/dialogEtGhostNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:hint="e.g. 1234 or 777"
                android:inputType="number"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_edit_text"/>

            <!-- Typing Delay Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Typing Start Delay (Seconds)"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Seconds of pause before the invisible spirit starts typing."
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/dialogEtGhostDelay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:hint="e.g. 3 (seconds)"
                android:inputType="number"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_edit_text"/>

            <!-- Save Ghost Settings Button -->
            <Button
                android:id="@+id/dialogBtnSaveGhost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:text="SAVE GHOST CONFIGURATION"
                android:textColor="#18181B"
                android:textStyle="bold"
                android:backgroundTint="#FFCC00"
                app:cornerRadius="14dp" />

            <!-- Performance Guide -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👻 How to Perform:"
                        android:textColor="#FFCC00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Set your Ghost Number and delay (e.g. 3s).\n2. Hand the phone to a spectator or place it on the table.\n3. Secretly activate your sensor trigger (e.g., proximity wave or shadow).\n4. Step back: After the delay, the calculator magically types every digit onto the screen in real-time without anyone touching the device!"
                        android:textColor="#BBFFFFFF"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
