<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#FF18181B"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Flip Performance Guide"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Magician's Performance Guide:"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Scrollable Instruction Steps -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/guideStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Programmatically populated steps -->
            </LinearLayout>
        </ScrollView>

        <!-- Interactive Practice Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideStartPractice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🎯 Practice Live (Interactive Coach)"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            app:cornerRadius="12dp"
            app:backgroundTint="#00E5FF"
            app:rippleColor="#88FFFFFF"
            android:visibility="visible" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/guideBtnClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Close Guide"
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#22FFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
