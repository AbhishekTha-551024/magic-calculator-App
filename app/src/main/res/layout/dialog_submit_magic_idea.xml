<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FF18181B"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Bar & Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Magic Idea &amp; Query Hub"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCloseIdeaDialog"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#88FFFFFF" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send your magic trick ideas or questions directly to the developer!"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Category Selector Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Category"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Category Buttons Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipNewTrick"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="🎩 New Trick"
                    android:textColor="#25D366"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_edit_text" />

                <TextView
                    android:id="@+id/chipQuery"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="❓ Question / Query"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_edit_text" />
            </LinearLayout>

            <!-- Category Buttons Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/chipBug"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:text="🐛 Report Bug"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_edit_text" />

                <TextView
                    android:id="@+id/chipImprovement"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="⚡ Improvement"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_edit_text" />
            </LinearLayout>

            <!-- Title / Subject Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title / Subject"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etIdeaTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:hint="e.g. Book Test Prediction Trick"
                android:inputType="textCapSentences"
                android:textColorHint="#55FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_edit_text" />

            <!-- Description Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe your Idea or Question"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etIdeaDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:gravity="top|start"
                android:hint="Explain how the trick should work, what spectator sees, or what question you have..."
                android:inputType="textMultiLine|textCapSentences"
                android:textColorHint="#55FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="@drawable/bg_edit_text" />

            <!-- Big Direct WhatsApp Action Button -->
            <Button
                android:id="@+id/btnDirectWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="💬 SEND ON WHATSAPP (+91 8815114272)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#25D366"
                app:cornerRadius="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opens WhatsApp directly with your message"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
