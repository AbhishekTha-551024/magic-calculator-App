<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#18181B"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Glowing Crown Header -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_popular_badge"
            android:backgroundTint="#26FFD700"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFD700" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉 VIP PASS ACTIVATED!"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All premium magic features &amp; disguise screens unlocked!"
            android:textColor="#A0A0A5"
            android:textSize="12sp"
            android:textAlignment="center"
            android:layout_marginBottom="20dp" />

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#12FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#25FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Plan Name & Status Chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtSuccessPlanName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Pass"
                        android:textColor="#00E5FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSuccessStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_popular_badge"
                        android:backgroundTint="#2210B981"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="● ACTIVE &amp; VERIFIED"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Taken On / Start Date Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Taken On (Start Date):"
                        android:textColor="#88FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSuccessStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 Oct 2026, 07:30 PM"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Valid Until / Expiry Date Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Valid Until (End Date):"
                        android:textColor="#88FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSuccessExpiryDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 Nov 2026, 07:30 PM"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Validity Countdown Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Validity Duration:"
                        android:textColor="#88FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtSuccessRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires in 30 Days"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Transaction ID Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment ID: "
                        android:textColor="#88FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtSuccessTxId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="pay_XXXX"
                        android:textColor="#A0A0A5"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" (Tap to copy)"
                        android:textColor="#55FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Button: Continue to Magic -->
        <Button
            android:id="@+id/btnSuccessDone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#FFD700"
            android:text="CONTINUE TO MAGIC ✨"
            android:textColor="#18181B"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:layout_marginBottom="8dp" />

        <!-- Secondary Button: View Payment Receipt / History -->
        <Button
            android:id="@+id/btnSuccessReceipt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#12FFFFFF"
            android:text="View Payment Receipt &amp; Orders"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
