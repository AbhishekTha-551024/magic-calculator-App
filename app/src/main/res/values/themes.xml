<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MagicCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/calc_btn_operator</item>
        <item name="android:statusBarColor">@color/calc_bg</item>
        <item name="android:windowBackground">@color/calc_bg</item>
        <item name="android:navigationBarColor">@color/calc_bg</item>
    </style>

    <!-- Base Circle Button Style -->
    <style name="CalcButton.Circle" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Circle</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/calc_text_white</item>
        <item name="backgroundTint">@color/calc_btn_num</item>
    </style>

    <!-- Light Gray Action Buttons (AC, %, Backspace) -->
    <style name="CalcButton.Circle.Action">
        <item name="backgroundTint">@color/calc_btn_action</item>
        <item name="android:textColor">@color/calc_text_white</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Orange Operator Buttons (/, *, -, +, =) -->
    <style name="CalcButton.Circle.Operator">
        <item name="backgroundTint">@color/calc_btn_operator</item>
        <item name="android:textColor">@color/calc_text_white</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- System Dialer Styles -->
    <style name="SystemDialButtonLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="SystemDialButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/dialer_text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="SystemDialButtonLetters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/dialer_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    
    <!-- Calling Screen Styles -->
    <style name="CallingActionStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    
    <style name="CallingTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
